# MikosChat Server

# Application
NODE_ENV=development
APP_NAME=MikosChat
PORT=3000

# Public URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://mikoschat:CHANGE_ME@127.0.0.1:5432/mikoschat

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Authentication
# Generate a unique secret: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Local file storage
STORAGE_PATH=./storage

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Trusted reverse proxy addresses (comma-separated)
# Leave empty when running without a reverse proxy.
TRUST_PROXY=
